-- ============================================================
-- 数据统计
-- ============================================================
SELECT '===== Mock 数据统计 =====' AS '';
SELECT COUNT(*) AS total FROM t_driver_daily_snapshot WHERE snapshot_date = '2026-07-29';

-- 过滤条件1: 近7天在线 >= 1
SELECT COUNT(*) AS pass_online_condition FROM t_driver_daily_snapshot
WHERE snapshot_date = '2026-07-29' AND online_count_7d >= 1;

-- 过滤条件2: 最后完单 <= 7天
SELECT COUNT(*) AS pass_order_condition FROM t_driver_daily_snapshot
WHERE snapshot_date = '2026-07-29' AND last_order_time >= '2026-07-22';

-- 过滤条件3: 供需比 >= 1.5
SELECT COUNT(*) AS pass_sd_condition FROM t_driver_daily_snapshot
WHERE snapshot_date = '2026-07-29' AND supply_demand_ratio >= 1.5;

-- 满足全部三个过滤条件
SELECT COUNT(*) AS pass_all_filters FROM t_driver_daily_snapshot
WHERE snapshot_date = '2026-07-29'
  AND online_count_7d >= 1
  AND last_order_time >= '2026-07-22'
  AND supply_demand_ratio >= 1.5;

-- 各画像标签预估分布 (按行为数据推算)
SELECT 'PRICE_SENSITIVE(预估)' AS persona, COUNT(*) AS cnt FROM t_driver_daily_snapshot
WHERE snapshot_date = '2026-07-29' AND driver_id BETWEEN 'D0001' AND 'D0010'
UNION ALL
SELECT 'TIME_SENSITIVE(预估)', COUNT(*) FROM t_driver_daily_snapshot
WHERE snapshot_date = '2026-07-29' AND driver_id BETWEEN 'D0011' AND 'D0020'
UNION ALL
SELECT 'WAY_HOME(预估)', COUNT(*) FROM t_driver_daily_snapshot
WHERE snapshot_date = '2026-07-29' AND driver_id BETWEEN 'D0021' AND 'D0030'
UNION ALL
SELECT 'WEEKEND_PART_TIME(预估)', COUNT(*) FROM t_driver_daily_snapshot
WHERE snapshot_date = '2026-07-29' AND driver_id BETWEEN 'D0031' AND 'D0040'
UNION ALL
SELECT 'STABLE_FULL_TIME(预估)', COUNT(*) FROM t_driver_daily_snapshot
WHERE snapshot_date = '2026-07-29' AND driver_id BETWEEN 'D0041' AND 'D0050'
UNION ALL
SELECT 'MIXED(混合/边界)', COUNT(*) FROM t_driver_daily_snapshot
WHERE snapshot_date = '2026-07-29' AND driver_id BETWEEN 'D0051' AND 'D0100';


