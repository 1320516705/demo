SELECT '===== 全部 Mock 数据统计 =====' AS '';
SELECT 't_driver_daily_snapshot' AS table_name, COUNT(*) AS row_count FROM t_driver_daily_snapshot WHERE snapshot_date = '2026-07-29'
UNION ALL SELECT 't_recall_pipeline_log', COUNT(*) FROM t_recall_pipeline_log WHERE data_date = '2026-07-29'
UNION ALL SELECT 't_recall_list', COUNT(*) FROM t_recall_list WHERE data_date = '2026-07-29'
UNION ALL SELECT 't_recall_kpi', COUNT(*) FROM t_recall_kpi WHERE data_date = '2026-07-29'
UNION ALL SELECT 't_daily_trend', COUNT(*) FROM t_daily_trend;

-- 触达状态分布
SELECT '----- 触达状态分布 -----' AS '';
SELECT outreach_status, COUNT(*) AS cnt FROM t_recall_list WHERE data_date = '2026-07-29' GROUP BY outreach_status ORDER BY cnt DESC;

-- 画像分布
SELECT '----- 画像分布 -----' AS '';
SELECT persona_tag, COUNT(*) AS cnt FROM t_recall_list WHERE data_date = '2026-07-29' GROUP BY persona_tag ORDER BY cnt DESC;

-- 高分TOP10
SELECT '----- 召回分 TOP 10 -----' AS '';
SELECT driver_name, recall_score, persona_tag, outreach_status FROM t_recall_list WHERE data_date = '2026-07-29' ORDER BY recall_score DESC LIMIT 10;
